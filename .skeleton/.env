# ------------------------------------------------------------------------------
# Snapcast version override. Update this value and restart your containers
# (i.e. 'docker compose up -d') to update your installation.
# ------------------------------------------------------------------------------

# SNAPCAST_VERSION=latest

# ------------------------------------------------------------------------------
# Path to your Snapserver configuration file. This file will be mounted as a 
# read-only path within the container.
# ------------------------------------------------------------------------------

# SNAPSERVER_CONFIG_PATH=./volumes/snapcast/snapserver.conf

# ------------------------------------------------------------------------------
# Container volume definitions. These may be named volumes or paths (absolute or
# relative to the 'docker-compose.yaml' file). If left unset, these will default
# to named Docker volumes.
# ------------------------------------------------------------------------------

# SNAPCAST_DATA_VOLUME=snapcast-data
# SNAPCAST_CACHE_VOLUME=snapcast-cache
